# Copy to a protected EnvironmentFile on the server. Do not commit credentials.
FFDC_HOST=127.0.0.1
FFDC_PORT=8088

# Server-side files. Keep these outside the source tree when possible.
FFDC_API_KEY_FILE=/etc/ffdc-analyzer/api_key.txt
FFDC_JIRA_SIMILAR_PAT_FILE=/etc/ffdc-analyzer/jira_similar_pat
FFDC_JIRA_MONITOR_CONFIG=/etc/ffdc-analyzer/defect_review_config.json
FFDC_SAMPLE=/var/lib/ffdc-analyzer/sample.tzz
FFDC_KEYFILES=/etc/ffdc-analyzer/keyfiles.txt

# AI provider and model defaults.
FFDC_OPENAI_BASE_URL=https://api.openai.com/v1
FFDC_OPENAI_MODEL=gpt-5.2
FFDC_CHAT_MODEL=nemotron-3-ultra
FFDC_DEEP_INVESTIGATION_MODEL=nemotron-3-ultra
FFDC_WORKSPACE_CHAT_MODEL=
FFDC_VISION_MODEL=gemma-4-31b-it

# Capacity and upstream pacing. Current source defaults are 64 parser workers,
# 4 concurrent AI calls, 44 admitted waiters, and a 0.5 second start interval.
FFDC_MAX_CONCURRENT_ANALYSES=64
FFDC_MAX_CONCURRENT_AI_REQUESTS=4
FFDC_MAX_QUEUED_AI_REQUESTS=44
FFDC_AI_REQUEST_QUEUE_TIMEOUT_SECONDS=90
FFDC_AI_MIN_START_INTERVAL_SECONDS=0.5
FFDC_JIRA_REQUEST_MIN_INTERVAL_SECONDS=2

# Integrations.
FFDC_JIRA_BASE_URL=https://jira1.labs.lenovo.com
FFDC_PROJECT_TOOL_BASE_URL=https://project-tool.labs.lenovo.com
FFDC_JIRA_MONITOR_FILTER_ID=34570
FFDC_UPCOMING_MILESTONE_REPORT_ID=562
FFDC_DEFECT_REVIEW_EMAIL_TO=RAIDAsia@LenovoBeijing.onmicrosoft.com
